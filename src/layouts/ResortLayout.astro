---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleHero from '../components/ArticleHero.astro';
import QuickFacts from '../components/QuickFacts.astro';
import ContentSection from '../components/ContentSection.astro';
import ProsCons from '../components/ProsCons.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedContent from '../components/RelatedContent.astro';
import { articleSchema, faqSchema, breadcrumbSchema } from '../lib/schema';

/**
 * Resort Article Layout
 * Hero -> overview -> who it's best for -> room options -> kids
 * facilities -> activities -> pros/cons -> nearby attractions ->
 * booking CTA -> FAQ -> related. As with DestinationLayout, the
 * room/facilities/activities/nearby blocks all come from
 * entry.data.sections — no schema change needed to add a new resort.
 */
interface Props {
  entry: CollectionEntry<'resorts'>;
  url: string;
  related: {
    href: string;
    image: ImageMetadata;
    imageAlt: string;
    category: string;
    title: string;
  }[];
}

const { entry, url, related } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Family resorts', href: '/resorts' },
  { name: data.title, href: url },
];

const article = articleSchema({
  title: data.title,
  description: data.description,
  imageUrl: url,
  url,
  authorName: data.author.name,
  publishDate: data.publishDate,
  updatedDate: data.updatedDate,
});
const faq = faqSchema(data.faq);
const breadcrumbsLd = breadcrumbSchema(breadcrumbItems.map((b) => ({ name: b.name, url: b.href })));

const quickFactsList = [
  { label: 'Location', value: data.location },
  ...(data.rating ? [{ label: 'Rating', value: `${data.rating.toFixed(1)} / 5` }] : []),
  ...data.quickFacts,
];
---

<BaseLayout title={data.title} description={data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    {faq && <script type="application/ld+json" set:html={JSON.stringify(faq)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Breadcrumbs items={breadcrumbItems.map((b) => ({ name: b.name, href: b.href }))} />

  <ArticleHero
    image={data.featuredImage}
    imageAlt={data.featuredImageAlt}
    category={data.category}
    title={data.title}
    authorName={data.author.name}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
  />

  <Container size="content" class="section">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div class="flex flex-col gap-12">
        <div>
          <p class="text-lg font-semibold text-green-dark">{data.bestForSummary}</p>
          <div class="prose-editorial mt-4 max-w-none text-lg leading-relaxed text-ink-soft">
            <Content />
          </div>
        </div>

        {data.sections.map((section) => (
          <ContentSection
            heading={section.heading}
            body={section.body}
            bullets={section.bullets}
            items={section.items}
          />
        ))}

        {data.prosCons && <ProsCons pros={data.prosCons.pros} cons={data.prosCons.cons} />}

        {data.ctas.length > 0 && (
          <AffiliateBox
            title={`Check availability at ${data.title}`}
            description="Prices and room availability change often — check the latest directly before you book."
            ctas={data.ctas}
          />
        )}

        <FAQSection items={data.faq} />
        <RelatedContent items={related} />
      </div>

      <aside class="lg:pt-2">
        <div class="sticky top-24 flex flex-col gap-6">
          <QuickFacts facts={quickFactsList} />
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>

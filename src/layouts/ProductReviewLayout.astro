---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleHero from '../components/ArticleHero.astro';
import QuickFacts from '../components/QuickFacts.astro';
import ContentSection from '../components/ContentSection.astro';
import ProsCons from '../components/ProsCons.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedContent from '../components/RelatedContent.astro';
import { articleSchema, faqSchema, breadcrumbSchema } from '../lib/schema';

/**
 * Product Review Layout
 * Hero -> intro -> quick facts (rating/price/spec) -> sections ->
 * pros/cons -> optional comparison table -> buy-link affiliate box ->
 * FAQ -> related. `comparisonTable` is passed in directly (built from
 * the page route) rather than living in the shared content schema,
 * since it's the one structure genuinely specific to product reviews.
 */
interface Props {
  entry: CollectionEntry<'products'>;
  url: string;
  related: {
    href: string;
    image: ImageMetadata;
    imageAlt: string;
    category: string;
    title: string;
  }[];
  comparisonTable?: {
    columns: string[];
    rows: { label: string; values: string[] }[];
    caption?: string;
  };
}

const { entry, url, related, comparisonTable } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Gear guides', href: '/products' },
  { name: data.title, href: url },
];

const article = articleSchema({
  title: data.title,
  description: data.description,
  imageUrl: url,
  url,
  authorName: data.author.name,
  publishDate: data.publishDate,
  updatedDate: data.updatedDate,
});
const faq = faqSchema(data.faq);
const breadcrumbsLd = breadcrumbSchema(breadcrumbItems.map((b) => ({ name: b.name, url: b.href })));

const quickFactsList = [
  ...(data.rating ? [{ label: 'Rating', value: `${data.rating.toFixed(1)} / 5` }] : []),
  ...(data.price ? [{ label: 'Price', value: data.price }] : []),
  ...data.quickFacts,
];

const buyCtas = data.buyLinks.map((link) => ({
  label: link.price ? `Buy at ${link.retailer} — ${link.price}` : `Buy at ${link.retailer}`,
  href: link.url,
  style: 'primary' as const,
}));
---

<BaseLayout title={data.title} description={data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    {faq && <script type="application/ld+json" set:html={JSON.stringify(faq)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Breadcrumbs items={breadcrumbItems.map((b) => ({ name: b.name, href: b.href }))} />

  <ArticleHero
    image={data.featuredImage}
    imageAlt={data.featuredImageAlt}
    category={data.category}
    title={data.title}
    authorName={data.author.name}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
  />

  <Container size="content" class="section">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div class="flex flex-col gap-12">
        <div class="prose-editorial max-w-none text-lg leading-relaxed text-ink-soft">
          <Content />
        </div>

        {data.sections.map((section) => (
          <ContentSection
            heading={section.heading}
            body={section.body}
            bullets={section.bullets}
            items={section.items}
          />
        ))}

        {data.prosCons && <ProsCons pros={data.prosCons.pros} cons={data.prosCons.cons} />}

        {comparisonTable && (
          <div>
            <h2 class="mb-5 text-2xl font-extrabold text-ink">How it compares</h2>
            <ComparisonTable {...comparisonTable} />
          </div>
        )}

        {buyCtas.length > 0 && (
          <AffiliateBox title={`Where to buy the ${data.title}`} ctas={buyCtas} />
        )}

        <FAQSection items={data.faq} />
        <RelatedContent items={related} />
      </div>

      <aside class="lg:pt-2">
        <div class="sticky top-24 flex flex-col gap-6">
          <QuickFacts facts={quickFactsList} title="At a glance" />
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>

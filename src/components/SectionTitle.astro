---
/**
 * SectionTitle
 * The editorial header used at the top of most homepage sections:
 * a short sentence-case kicker, a large display heading, and an
 * optional supporting line. Alignment defaults to left (magazine-style),
 * with a centered option for narrower, single-column moments.
 */
interface Props {
  kicker?: string;
  heading: string;
  supporting?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  /** Use 'h1' when this is a page's main heading (most listing/utility
   * pages) rather than a section within a page that already has its
   * own h1 (e.g. content pages via ArticleHero, the homepage Hero). */
  level?: 'h1' | 'h2';
  class?: string;
}

const {
  kicker,
  heading,
  supporting,
  align = 'left',
  tone = 'light',
  level = 'h2',
  class: className,
} = Astro.props;
const Heading = level;
---

<div
  class:list={[
    'flex flex-col gap-4',
    align === 'center' ? 'items-center text-center mx-auto max-w-2xl' : 'items-start text-left',
    className,
  ]}
>
  {kicker && (
    <p class:list={[tone === 'dark' ? 'font-bold text-sm text-green-light' : 'kicker']}>
      {kicker}
    </p>
  )}
  <Heading
    class:list={[
      'text-3xl sm:text-4xl',
      tone === 'dark' ? 'text-white' : 'text-ink',
    ]}
  >
    {heading}
  </Heading>
  {supporting && (
    <p class:list={['text-lg', tone === 'dark' ? 'text-white/85' : 'text-ink-soft']}>
      {supporting}
    </p>
  )}
</div>

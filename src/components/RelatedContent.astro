---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * RelatedContent
 * A simple grid of related pieces of content — used at the bottom of
 * every destination/resort/article/product page. Takes already-
 * resolved items (see the [...slug].astro routes, which resolve the
 * `relatedArticles` string references against the real collections)
 * rather than doing any lookup itself, so it stays reusable across
 * all four content types.
 */
interface RelatedItem {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  category: string;
  title: string;
}

interface Props {
  items: RelatedItem[];
  title?: string;
}

const { items, title = 'You might also like' } = Astro.props;
---

{items.length > 0 && (
  <div>
    <h2 class="text-2xl font-extrabold text-ink">{title}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <a href={item.href} class="group flex flex-col gap-3">
          <div class="aspect-[16/10] overflow-hidden rounded-xl">
            <Image
              src={item.image}
              alt={item.imageAlt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-green-dark">{item.category}</p>
            <h3 class="mt-1 text-base font-bold leading-snug text-ink group-hover:text-green-dark">
              {item.title}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

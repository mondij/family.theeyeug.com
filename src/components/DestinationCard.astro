---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * DestinationCard
 * A large, photo-led card for a country/region-level destination.
 * Editorial in tone — a short line of "why here", not a listing —
 * so this reads as brand content rather than an affiliate tile.
 */
interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  name: string;
  teaser: string;
  priority?: boolean;
  class?: string;
  /** 'h3' when nested under a section heading (default); 'h2' when
   * this card's title is the first heading after a page's own h1. */
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  image,
  imageAlt,
  name,
  teaser,
  priority = false,
  class: className,
  headingLevel = 'h3',
} = Astro.props;
const Heading = headingLevel;
---

<a
  href={href}
  class:list={[
    'group relative flex aspect-[3/4] flex-col justify-end overflow-hidden rounded-2xl',
    className,
  ]}
>
  <Image
    src={image}
    alt={imageAlt}
    widths={[360, 480, 640, 900]}
    sizes="(min-width: 1024px) 20vw, (min-width: 640px) 45vw, 90vw"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/15 to-transparent"></div>
  <div class="relative z-10 p-5 sm:p-6">
    <Heading class="text-2xl font-extrabold text-white">{name}</Heading>
    <p class="mt-1.5 text-sm leading-relaxed text-white/90">{teaser}</p>
  </div>
</a>

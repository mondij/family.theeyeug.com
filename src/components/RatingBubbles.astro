---
/**
 * RatingBubbles
 * The circle-rating pattern travel-search sites use for at-a-glance
 * trust: five dots, filled left-to-right (including half-fills for
 * .5 ratings), plus the numeric score and review count.
 */
interface Props {
  rating: number; // 0–5, supports halves (e.g. 4.5)
  reviewCount?: number;
  size?: 'sm' | 'md';
  class?: string;
}

const { rating, reviewCount, size = 'md', class: className } = Astro.props;

const clamped = Math.max(0, Math.min(5, rating));
const bubbles = Array.from({ length: 5 }, (_, i) => {
  const diff = clamped - i;
  if (diff >= 1) return 1;
  if (diff >= 0.5) return 0.5;
  if (diff > 0) return diff;
  return 0;
});

const textSize = size === 'sm' ? 'text-xs' : 'text-sm';
const dotSize = size === 'sm' ? 'h-3 w-3' : 'h-3.5 w-3.5';
---

<span class:list={['inline-flex items-center gap-1.5', className]}>
  <span class="rating-bubbles" aria-hidden="true">
    {bubbles.map((fillAmount) => (
      <span class:list={['bubble', dotSize]}>
        {fillAmount > 0 && (
          <span class="fill" style={`clip-path: inset(0 ${100 - fillAmount * 100}% 0 0)`}></span>
        )}
      </span>
    ))}
  </span>
  <span class:list={['font-semibold text-ink', textSize]}>{clamped.toFixed(1)}</span>
  {typeof reviewCount === 'number' && (
    <span class:list={['text-ink-soft', textSize]}>({reviewCount.toLocaleString()})</span>
  )}
  <span class="sr-only">{clamped.toFixed(1)} out of 5{typeof reviewCount === 'number' ? `, ${reviewCount} reviews` : ''}</span>
</span>

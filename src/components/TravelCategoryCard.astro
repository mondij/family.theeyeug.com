---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * TravelCategoryCard
 * A bold, image-led tile for browsing by trip type (Beach, Theme
 * Parks, Adventure...). Deliberately simple — one photo, one label —
 * so a row of six reads as a clean entry point, not a listing.
 */
interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  label: string;
  priority?: boolean;
}

const { href, image, imageAlt, label, priority = false } = Astro.props;
---

<a href={href} class="group flex flex-col gap-3">
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl">
    <Image
      src={image}
      alt={imageAlt}
      widths={[280, 400, 560]}
      sizes="(min-width: 1024px) 18vw, (min-width: 640px) 30vw, 45vw"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading={priority ? 'eager' : 'lazy'}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/35 via-transparent to-transparent"></div>
  </div>
  <span class="text-[0.95rem] font-bold text-ink transition-colors group-hover:text-green-dark sm:text-base">
    {label}
  </span>
</a>

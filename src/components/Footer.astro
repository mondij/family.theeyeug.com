---
import Container from './Container.astro';

const currentYear = new Date().getFullYear();

const columns = [
  {
    heading: 'Explore',
    links: [
      { label: 'Destinations', href: '/destinations' },
      { label: 'Trip styles', href: '/trip-styles' },
      { label: 'Family resorts', href: '/resorts' },
      { label: 'Seasonal guides', href: '/journal/seasonal' },
    ],
  },
  {
    heading: 'Plan',
    links: [
      { label: 'Start planning', href: '/plan' },
      { label: 'Packing lists', href: '/journal/packing' },
      { label: 'Travel advice', href: '/advice' },
      { label: 'Budget calculator', href: '/tools/budget' },
    ],
  },
  {
    heading: 'Nestward',
    links: [
      { label: 'About us', href: '/about' },
      { label: 'How we choose', href: '/editorial-standards' },
      { label: 'Contact', href: '/contact' },
      { label: 'Work with us', href: '/partners' },
    ],
  },
];
---

<footer class="bg-ink text-sand">
  <Container size="wide" class="section">
    <div class="grid gap-14 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-sm">
        <p class="text-2xl font-extrabold tracking-tight text-white">nestward</p>
        <p class="mt-4 text-[0.98rem] leading-relaxed text-sand/85">
          Thoughtful trip planning for families who want their next holiday to
          feel like an adventure worth telling stories about.
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <p class="text-sm font-semibold text-linen">{column.heading}</p>
          <ul class="mt-4 flex flex-col gap-3">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-[0.95rem] text-sand/80 transition-colors hover:text-linen">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-sand/15 pt-8 text-sm text-sand/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} Nestward Travel Ltd. All rights reserved.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/privacy" class="hover:text-sand">Privacy policy</a>
        <a href="/terms" class="hover:text-sand">Terms of use</a>
        <a href="/affiliate-disclosure" class="hover:text-sand">Affiliate disclosure</a>
      </div>
    </div>
  </Container>
</footer>

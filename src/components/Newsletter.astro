---
import Container from './Container.astro';
import Button from './Button.astro';

/**
 * Newsletter
 * A calm, trust-first email capture — no urgency copy, no discount
 * bait. Explains what they get and how often, plus an explicit
 * no-spam line, since that's what separates this from an affiliate
 * pop-up.
 */
interface Props {
  heading?: string;
  supporting?: string;
}

const {
  heading = 'Get one thoughtful trip idea a month',
  supporting = 'Real destination guides and family travel advice — no spam, no daily blasts, unsubscribe whenever you like.',
} = Astro.props;
---

<section class="section bg-green-light">
  <Container size="content">
    <div class="flex flex-col items-center gap-6 text-center">
      <h2 class="text-3xl font-extrabold text-ink sm:text-4xl">{heading}</h2>
      <p class="max-w-xl text-lg text-ink-soft">{supporting}</p>

      <form class="mt-2 flex w-full max-w-md flex-col gap-3 sm:flex-row">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          required
          placeholder="you@example.com"
          class="w-full rounded-lg border border-border bg-white px-4 py-3 text-sm text-ink placeholder:text-ink-faint focus:border-green focus:outline-none"
        />
        <Button type="submit" variant="primary" class="shrink-0 justify-center">Subscribe</Button>
      </form>
      <p class="text-xs text-ink-faint">No spam, ever. Unsubscribe with one click.</p>
    </div>
  </Container>
</section>

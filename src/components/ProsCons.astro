---
/**
 * ProsCons
 * Balanced two-column pros/cons list for resort and product reviews.
 * Deliberately shows both sides with equal visual weight — part of
 * reading as an honest review rather than a sales page.
 */
interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2">
  <div class="card p-6">
    <h3 class="flex items-center gap-2 text-base font-extrabold text-ink">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-green-light text-green-dark">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      What we liked
    </h3>
    <ul class="mt-4 flex flex-col gap-2.5">
      {pros.map((pro) => (
        <li class="flex items-start gap-2 text-sm text-ink-soft">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-green"></span>
          {pro}
        </li>
      ))}
    </ul>
  </div>

  <div class="card p-6">
    <h3 class="flex items-center gap-2 text-base font-extrabold text-ink">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-coral-light text-coral-deep">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </span>
      Worth knowing
    </h3>
    <ul class="mt-4 flex flex-col gap-2.5">
      {cons.map((con) => (
        <li class="flex items-start gap-2 text-sm text-ink-soft">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-coral"></span>
          {con}
        </li>
      ))}
    </ul>
  </div>
</div>

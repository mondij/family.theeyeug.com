---
/**
 * FAQSection
 * Renders a list of questions as native <details> accordions — no JS
 * needed. The layout using this component is responsible for also
 * emitting faqSchema(faq) as JSON-LD so the same content earns a
 * Google FAQ rich result — this component is UI only.
 */
interface Props {
  items: { question: string; answer: string }[];
  title?: string;
}

const { items, title = 'Frequently asked questions' } = Astro.props;
---

{items.length > 0 && (
  <div>
    <h2 class="text-2xl font-extrabold text-ink">{title}</h2>
    <div class="mt-5 flex flex-col divide-y divide-border rounded-xl border border-border">
      {items.map((item) => (
        <details class="group p-5 open:bg-bg-subtle/40">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
            {item.question}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              class="shrink-0 text-ink-soft transition-transform duration-200 group-open:rotate-45"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
)}

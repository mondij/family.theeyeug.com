---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RatingBubbles from './RatingBubbles.astro';

/**
 * ImageCard
 * The primary discovery card — photo on top, details in a white panel
 * below (rating bubbles, review count, price), matching how
 * travel-search sites like TripAdvisor structure a listing card so
 * the trust signals (rating, review volume, price) are always visible
 * rather than overlaid on the photo.
 */
interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  location?: string;
  rating?: number;
  reviewCount?: number;
  price?: string;
  priceUnit?: string;
  aspect?: 'portrait' | 'square' | 'wide';
  priority?: boolean;
  class?: string;
  /** 'h3' when nested under a section heading (default); 'h2' when
   * this card's title is the first heading after a page's own h1. */
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  image,
  imageAlt,
  title,
  location,
  rating,
  reviewCount,
  price,
  priceUnit,
  aspect = 'wide',
  priority = false,
  class: className,
  headingLevel = 'h3',
} = Astro.props;
const Heading = headingLevel;

const aspectClass = {
  portrait: 'aspect-[4/5]',
  square: 'aspect-square',
  wide: 'aspect-[4/3]',
}[aspect];
---

<a
  href={href}
  class:list={[
    'card card-hover group flex flex-col overflow-hidden p-0',
    className,
  ]}
>
  <div class:list={['relative overflow-hidden', aspectClass]}>
    <Image
      src={image}
      alt={imageAlt}
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
    {Astro.slots.has('badge') && (
      <div class="absolute left-3 top-3">
        <slot name="badge" />
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <Heading class="text-base font-bold leading-snug text-ink">{title}</Heading>
    {location && <p class="text-sm text-ink-soft">{location}</p>}
    {typeof rating === 'number' && (
      <RatingBubbles rating={rating} reviewCount={reviewCount} size="sm" class="mt-0.5" />
    )}
    {Astro.slots.has('default') && (
      <div class="mt-1 flex flex-wrap gap-1.5">
        <slot />
      </div>
    )}
    {price && (
      <div class="mt-2 flex items-baseline gap-1 border-t border-border pt-2.5">
        <span class="text-xs text-ink-soft">from</span>
        <span class="text-lg font-extrabold text-ink">{price}</span>
        {priceUnit && <span class="text-xs text-ink-soft">{priceUnit}</span>}
      </div>
    )}
  </div>
</a>

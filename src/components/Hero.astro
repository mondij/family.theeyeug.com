---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from './Container.astro';
import Button from './Button.astro';

/**
 * Hero
 * The cinematic opener for discovery-style pages: a large photo,
 * a short emotional headline, one supporting line, and up to two
 * calls to action. Kept deliberately free of search fields/forms —
 * this is a brand moment, not a booking widget.
 */
interface Props {
  image: ImageMetadata;
  imageAlt: string;
  headline: string;
  supporting?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  height?: 'default' | 'tall';
}

const {
  image,
  imageAlt,
  headline,
  supporting,
  primaryCta,
  secondaryCta,
  height = 'default',
} = Astro.props;

const heightClass = height === 'tall' ? 'h-[640px] sm:h-[720px]' : 'h-[520px] sm:h-[600px]';
---

<section class:list={['relative overflow-hidden', heightClass]}>
  <Image
    src={image}
    alt={imageAlt}
    widths={[768, 1280, 1920, 2400]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover"
    priority
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/25 to-ink/10"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-ink/40 via-transparent to-transparent"></div>

  <Container size="wide" class="relative z-10 flex h-full flex-col justify-end pb-14 sm:pb-20">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-extrabold leading-tight text-white drop-shadow-sm sm:text-5xl lg:text-6xl">
        {headline}
      </h1>
      {supporting && (
        <p class="mt-4 max-w-xl text-lg text-white/95 drop-shadow-sm sm:text-xl">
          {supporting}
        </p>
      )}
      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap gap-4">
          {primaryCta && (
            <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>
          )}
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="on-dark">{secondaryCta.label}</Button>
          )}
        </div>
      )}
    </div>
  </Container>
</section>

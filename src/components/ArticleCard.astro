---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * ArticleCard
 * Magazine-style preview: photo, a category kicker, headline, short
 * excerpt, and a byline/read-time line. Used for the Travel
 * Inspiration section and, later, journal listing pages.
 */
interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  category: string;
  title: string;
  excerpt: string;
  meta?: string;
  featured?: boolean;
  priority?: boolean;
  /** 'h3' when nested under a section heading (default); 'h2' when
   * this card's title is the first heading after a page's own h1. */
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  image,
  imageAlt,
  category,
  title,
  excerpt,
  meta,
  featured = false,
  priority = false,
  headingLevel = 'h3',
} = Astro.props;
const Heading = headingLevel;
---

<a
  href={href}
  class:list={[
    'group grid gap-5',
    featured ? 'sm:grid-cols-2 sm:items-center' : 'grid-cols-1',
  ]}
>
  <div class:list={['relative overflow-hidden rounded-2xl', featured ? 'aspect-[4/3]' : 'aspect-[16/10]']}>
    <Image
      src={image}
      alt={imageAlt}
      widths={[420, 640, 900, featured ? 1100 : 900]}
      sizes={featured ? '(min-width: 640px) 45vw, 90vw' : '(min-width: 1024px) 30vw, 90vw'}
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  <div class:list={['flex flex-col gap-2', featured && 'sm:pr-4']}>
    <p class="text-xs font-bold uppercase tracking-wide text-green-dark">{category}</p>
    <Heading class:list={['font-extrabold leading-snug text-ink', featured ? 'text-2xl sm:text-3xl' : 'text-lg']}>
      {title}
    </Heading>
    <p class:list={['text-ink-soft', featured ? 'text-base' : 'text-sm']}>{excerpt}</p>
    {meta && <p class="mt-1 text-xs text-ink-faint">{meta}</p>}
  </div>
</a>

---
import Container from './Container.astro';
import Button from './Button.astro';

const navLinks = [
  { label: 'Destinations', href: '/destinations' },
  { label: 'Trip styles', href: '/trip-styles' },
  { label: 'Journal', href: '/journal' },
  { label: 'Advice', href: '/advice' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-500">
  <Container size="wide">
    <div class="flex h-20 items-center justify-between">
      <a href="/" class="flex items-center gap-2" aria-label="Nestward home">
        <span class="header-mark text-2xl italic transition-colors duration-500">Nestward</span>
      </a>

      <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="header-link text-[0.95rem] font-medium transition-colors duration-500"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden lg:block">
        <Button href="/plan" variant="primary" class="header-cta">Start planning</Button>
      </div>

      <button
        id="menu-toggle"
        class="header-link flex h-10 w-10 items-center justify-center lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg width="22" height="16" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 1H22" stroke="currentColor" stroke-width="1.5"></path>
          <path d="M0 8H22" stroke="currentColor" stroke-width="1.5"></path>
          <path d="M0 15H22" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </Container>

  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 bg-linen px-6 pb-6 pt-2 shadow-lg lg:hidden"
  >
    {navLinks.map((link) => (
      <a href={link.href} class="rounded-lg px-3 py-3 text-ink hover:bg-sand">
        {link.label}
      </a>
    ))}
    <Button href="/plan" variant="primary" class="mt-2 justify-center">Start planning</Button>
  </div>
</header>

<style>
  #site-header {
    background-color: transparent;
  }

  #site-header.is-scrolled {
    background-color: var(--color-linen);
    box-shadow: 0 1px 0 rgba(16, 34, 43, 0.08);
  }

  .header-mark {
    font-family: var(--font-display);
    color: var(--color-linen);
  }

  .header-link {
    color: rgba(251, 247, 240, 0.92);
  }

  #site-header.is-scrolled .header-mark,
  #site-header.is-scrolled .header-link {
    color: var(--color-ink);
  }

  #site-header:not(.is-scrolled) :global(.header-cta.btn-primary) {
    box-shadow: 0 10px 24px -10px rgba(16, 34, 43, 0.45);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setScrolled = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 24);
  };

  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    // A menu open on a transparent header needs a solid backdrop to read.
    header?.classList.toggle('is-scrolled', Boolean(isOpen) || window.scrollY > 24);
  });
</script>

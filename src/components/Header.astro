---
import Container from './Container.astro';
import Button from './Button.astro';

const navLinks = [
  { label: 'Hotels & resorts', href: '/destinations' },
  { label: 'Things to do', href: '/trip-styles' },
  { label: 'Journal', href: '/articles' },
  { label: 'Advice', href: '/advice' },
];
---

<header id="site-header" class="sticky top-0 z-50 border-b border-border bg-white">
  <div class="border-b border-border bg-green-deeper">
    <Container size="wide">
      <div class="flex h-9 items-center justify-end gap-5 text-xs font-medium text-white/85">
        <a href="/partners" class="hidden hover:text-white sm:inline">List your property</a>
        <a href="/plan" class="hidden hover:text-white sm:inline">Trip planner</a>
        <a href="/account" class="hover:text-white">Sign in</a>
      </div>
    </Container>
  </div>

  <Container size="wide">
    <div class="flex items-center justify-between gap-4 py-3">
      <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Nestward home">
        <svg width="28" height="28" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="64" height="64" rx="16" fill="#0AA06E"/>
          <circle cx="40" cy="22" r="10" fill="#ffffff" fill-opacity="0.9"/>
          <path d="M0 40C8 34 16 34 24 40C32 46 40 46 48 40C52 37 56 36 64 38V64H0V40Z" fill="#ffffff"/>
        </svg>
        <span class="text-xl font-extrabold tracking-tight text-ink sm:text-2xl">nestward</span>
      </a>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="whitespace-nowrap text-[0.95rem] font-semibold text-ink-soft transition-colors hover:text-green-dark"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <Button href="/plan" variant="primary" class="shrink-0 !px-4 sm:!px-6">Start planning</Button>
    </div>

    <nav
      class="flex items-center gap-5 overflow-x-auto border-t border-border py-2.5 lg:hidden"
      aria-label="Primary"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="whitespace-nowrap text-sm font-semibold text-ink-soft transition-colors hover:text-green-dark"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </Container>
</header>

---
interface Props {
  name: 'bed' | 'ticket' | 'fork' | 'home' | 'ship' | 'plane';
}

const { name } = Astro.props;
---

{name === 'bed' && (
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M3 18v2M21 18v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M3 13V7a2 2 0 0 1 2-2h4v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="7.5" cy="8.5" r="1.4" stroke="currentColor" stroke-width="1.6"/>
  </svg>
)}

{name === 'ticket' && (
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4V8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M14 6v12" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2 2"/>
  </svg>
)}

{name === 'fork' && (
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M7 3v7a2 2 0 0 0 4 0V3M9 10v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M16 3c-1.5 1-2 3-2 5s.5 3 2 3v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === 'home' && (
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 11.5 12 4l8 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M6 10v9a1 1 0 0 0 1 1h4v-6h2v6h4a1 1 0 0 0 1-1v-9" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
  </svg>
)}

{name === 'ship' && (
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 15l1.5 5h13L20 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M6 15V6h9l3 9" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M10 6V3h3v3" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>
)}

{name === 'plane' && (
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10.5 20l1-6.5L3 11l1.5-2 8-.5 2-5 2 .5-1 5.5 6 3v2l-6-1-1 4.5 2.5 1.5v1.5L13 19.5 10.5 21z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
  </svg>
)}

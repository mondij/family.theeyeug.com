---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import Badge from './Badge.astro';

/**
 * ResortCard
 * A premium resort listing: photo, name, location, a "best for" line,
 * and one clear call to action. No price or review-count clutter —
 * this section is meant to feel like a curated shortlist, not a
 * booking-engine grid.
 */
interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  name: string;
  location: string;
  bestFor: string;
  ctaLabel?: string;
  priority?: boolean;
  /** 'h3' when nested under a section heading (default); 'h2' when
   * this card's title is the first heading after a page's own h1. */
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  image,
  imageAlt,
  name,
  location,
  bestFor,
  ctaLabel = 'View resort',
  priority = false,
  headingLevel = 'h3',
} = Astro.props;
const Heading = headingLevel;
---

<div class="card card-hover flex flex-col overflow-hidden p-0">
  <a href={href} class="relative block aspect-[4/3] overflow-hidden">
    <Image
      src={image}
      alt={imageAlt}
      widths={[360, 480, 640, 900]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full object-cover transition-transform duration-500 ease-out hover:scale-105"
      loading={priority ? 'eager' : 'lazy'}
    />
  </a>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div>
      <Heading class="text-xl font-extrabold text-ink">
        <a href={href} class="hover:text-green-dark">{name}</a>
      </Heading>
      <p class="mt-1 text-sm text-ink-soft">{location}</p>
    </div>
    <Badge variant="green" class="w-fit">Best for {bestFor}</Badge>
    <div class="mt-auto pt-3">
      <Button href={href} variant="secondary" class="w-full justify-center">{ctaLabel}</Button>
    </div>
  </div>
</div>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Hero from '../components/Hero.astro';
import TravelCategoryCard from '../components/TravelCategoryCard.astro';
import DestinationCard from '../components/DestinationCard.astro';
import ResortCard from '../components/ResortCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';

import heroFamily from '../assets/images/hero-family.jpg';
import catBeach from '../assets/images/cat-beach.jpg';
import catThemeParks from '../assets/images/cat-theme-parks.jpg';
import catAllInclusive from '../assets/images/cat-all-inclusive.jpg';
import catAdventure from '../assets/images/cat-adventure.jpg';
import catCityBreaks from '../assets/images/cat-city-breaks.jpg';
import catNationalParks from '../assets/images/cat-national-parks.jpg';
import destFlorida from '../assets/images/dest-florida.jpg';
import destCaribbean from '../assets/images/dest-caribbean.jpg';
import destItaly from '../assets/images/dest-italy.jpg';
import destMexico from '../assets/images/dest-mexico.jpg';
import destJapan from '../assets/images/dest-japan.jpg';
import resortLagoon from '../assets/images/resort-lagoon.jpg';
import destinationMountain from '../assets/images/destination-mountain.jpg';
import destinationDesert from '../assets/images/destination-desert.jpg';
import articlePacking from '../assets/images/article-packing.jpg';
import articleBudget from '../assets/images/article-budget.jpg';
import journalBanner from '../assets/images/journal-banner.jpg';

const categories = [
  { label: 'Beach Vacations', image: catBeach, href: '/trip-styles/beach' },
  { label: 'Theme Parks', image: catThemeParks, href: '/trip-styles/theme-parks' },
  { label: 'All-Inclusive Resorts', image: catAllInclusive, href: '/trip-styles/all-inclusive' },
  { label: 'Adventure Trips', image: catAdventure, href: '/trip-styles/adventure' },
  { label: 'City Breaks', image: catCityBreaks, href: '/trip-styles/city-breaks' },
  { label: 'National Parks', image: catNationalParks, href: '/trip-styles/national-parks' },
];

const destinations = [
  {
    name: 'Florida',
    image: destFlorida,
    teaser: 'Endless beaches and theme parks, with some of the easiest flights from anywhere in North America.',
  },
  {
    name: 'Caribbean',
    image: destCaribbean,
    teaser: 'Turquoise water and slow mornings, spread across a dozen islands built for easy family trips.',
  },
  {
    name: 'Italy',
    image: destItaly,
    teaser: 'Gelato, ruins, and villages small enough for little legs to explore on foot.',
  },
  {
    name: 'Mexico',
    image: destMexico,
    teaser: 'All-inclusive resorts and warm water, a short flight from most major US and Canadian cities.',
  },
  {
    name: 'Japan',
    image: destJapan,
    teaser: 'Bullet trains, gentle temples, and some of the most kid-delighted food on earth.',
  },
];

const resorts = [
  {
    name: 'Coral Lagoon Resort & Spa',
    location: 'Riviera Maya, Mexico',
    bestFor: 'toddlers & preschoolers',
    image: resortLagoon,
    href: '/resorts/coral-lagoon',
  },
  {
    name: 'Alpine Meadow Family Lodge',
    location: 'Interlaken, Switzerland',
    bestFor: 'tweens & teens',
    image: destinationMountain,
    href: '/resorts/alpine-meadow',
  },
  {
    name: 'Dune Valley Ranch Resort',
    location: 'Scottsdale, Arizona',
    bestFor: 'multigenerational trips',
    image: destinationDesert,
    href: '/resorts/dune-valley',
  },
];

const tips = [
  {
    title: 'Build in one lazy day',
    body: 'Every trip needs at least one day with nothing booked — it\u2019s usually the one everyone remembers fondly.',
  },
  {
    title: 'Let each kid pick one thing',
    body: 'One activity, restaurant, or stop chosen entirely by them. It costs little and heads off a lot of complaining.',
  },
  {
    title: 'Pack a small "new toy" for travel days',
    body: 'Something they haven\u2019t seen before buys 45 minutes of quiet on a flight or long drive. Wrap it, even.',
  },
  {
    title: 'Check entry requirements early',
    body: 'Passport expiry dates, visa rules, and vaccination requirements are the easiest thing to leave too late.',
  },
];
---

<BaseLayout
  title="Nestward — family trip planning, done properly"
  description="Discover family-friendly destinations, resorts, and travel advice — with honest guides written for parents, not algorithms."
>
  <Hero
    image={heroFamily}
    imageAlt="Golden hour illustration of a warm family beach at sunset"
    headline="Create memories that last a lifetime"
    supporting="Discover destinations, resorts, and travel ideas curated for families — so the planning feels as good as the trip."
    primaryCta={{ label: 'Explore destinations', href: '/destinations' }}
    secondaryCta={{ label: 'Find family resorts', href: '/resorts' }}
  />

  <!-- Vacation Discovery -->
  <section class="section">
    <Container size="wide">
      <SectionTitle
        kicker="Start here"
        heading="What kind of trip are you dreaming of?"
        supporting="Six ways families usually start planning — pick one to see destinations and resorts that fit."
      />
      <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
        {categories.map((cat, i) => (
          <TravelCategoryCard
            href={cat.href}
            image={cat.image}
            imageAlt={`Illustration representing ${cat.label}`}
            label={cat.label}
            priority={i < 3}
          />
        ))}
      </div>
    </Container>
  </section>

  <!-- Featured Destinations -->
  <section class="section bg-bg-subtle">
    <Container size="wide">
      <SectionTitle
        kicker="Featured destinations"
        heading="Five places families keep going back to"
        supporting="Chosen for the mix of things that actually matter with kids: flight time, food options, and something for every age."
      />
      <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
        {destinations.map((dest, i) => (
          <DestinationCard
            href={`/destinations/${dest.name.toLowerCase()}`}
            image={dest.image}
            imageAlt={`Illustration representing ${dest.name}`}
            name={dest.name}
            teaser={dest.teaser}
            priority={i === 0}
            class={i === 4 ? 'col-span-2 sm:col-span-1' : ''}
          />
        ))}
      </div>
    </Container>
  </section>

  <!-- Family Resorts -->
  <section class="section">
    <Container size="wide">
      <SectionTitle
        kicker="Family resorts"
        heading="A short, honest shortlist of resorts we’d actually book"
        supporting="No sponsored placements — every resort here earned its spot from reviews and our own editors' research."
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {resorts.map((resort) => (
          <ResortCard
            href={resort.href}
            image={resort.image}
            imageAlt={`Illustration representing ${resort.name}`}
            name={resort.name}
            location={resort.location}
            bestFor={resort.bestFor}
          />
        ))}
      </div>
    </Container>
  </section>

  <!-- Travel Inspiration -->
  <section class="section bg-bg-subtle">
    <Container size="wide">
      <SectionTitle
        kicker="Travel inspiration"
        heading="Longer reads for the planning rabbit-hole hours"
      />
      <div class="mt-10 flex flex-col gap-12">
        <ArticleCard
          href="/journal/packing-list"
          image={articlePacking}
          imageAlt="Warm illustration of a coastline at dusk"
          category="Packing"
          title="The 20-minute packing list that actually works"
          excerpt="A parent-tested system for packing a family of four without the 11pm meltdown over missing swimsuits."
          meta="8 min read"
          featured
          priority
        />
        <div class="grid gap-8 sm:grid-cols-2">
          <ArticleCard
            href="/journal/flying-with-toddlers"
            image={journalBanner}
            imageAlt="Warm illustration of a dawn sky over gentle hills"
            category="Flying with kids"
            title="How to fly with toddlers and (mostly) enjoy it"
            excerpt="What actually helps on a long-haul flight, from seat selection to snack timing."
            meta="6 min read"
          />
          <ArticleCard
            href="/journal/family-trips-on-a-budget"
            image={articleBudget}
            imageAlt="Warm illustration of rolling hills at sunset"
            category="Budget travel"
            title="Family trips that don't break the budget"
            excerpt="Where the real savings are — and the corners that aren't worth cutting when you're travelling with kids."
            meta="7 min read"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Family Travel Tips -->
  <section class="section">
    <Container size="wide">
      <SectionTitle
        kicker="Quick tips"
        heading="Small things that make a big difference"
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {tips.map((tip) => (
          <Card padding="spacious">
            <h3 class="text-lg font-extrabold text-ink">{tip.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-soft">{tip.body}</p>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <Newsletter />
</BaseLayout>

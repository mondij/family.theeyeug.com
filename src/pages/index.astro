---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Hero from '../components/Hero.astro';
import TravelCategoryCard from '../components/TravelCategoryCard.astro';
import DestinationCard from '../components/DestinationCard.astro';
import ResortCard from '../components/ResortCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Button from '../components/Button.astro';
import { tripStyles } from '../lib/tripStyles';

import heroFamily from '../assets/images/hero-family.jpg';
import catBeach from '../assets/images/cat-beach.jpg';
import catThemeParks from '../assets/images/cat-theme-parks.jpg';
import catAllInclusive from '../assets/images/cat-all-inclusive.jpg';
import catAdventure from '../assets/images/cat-adventure.jpg';
import catCityBreaks from '../assets/images/cat-city-breaks.jpg';
import catNationalParks from '../assets/images/cat-national-parks.jpg';

const categoryImages: Record<string, ImageMetadata> = {
  beach: catBeach,
  'theme-parks': catThemeParks,
  'all-inclusive': catAllInclusive,
  adventure: catAdventure,
  'city-breaks': catCityBreaks,
  'national-parks': catNationalParks,
};

// Everything below is pulled live from the content collections rather
// than hardcoded, so the homepage can never point at a destination,
// resort, or article that doesn't actually exist.
const featuredByDateDesc = <T extends { data: { featured: boolean; publishDate: Date } }>(entries: T[]) =>
  [...entries].sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  });

const allDestinations = await getCollection('destinations');
const topDestinations = featuredByDateDesc(allDestinations).slice(0, 5);

const allResorts = await getCollection('resorts');
const resortRoundupCategories = [
  'All-Inclusive Resorts',
  'Caribbean Resorts',
  'Beach Resorts',
  'Luxury Resorts',
  'Kids Clubs',
];
const allArticles = await getCollection('articles');
const resortRoundups = allArticles.filter((entry) => resortRoundupCategories.includes(entry.data.category));

const journalEntries = featuredByDateDesc(
  allArticles.filter((entry) => !resortRoundupCategories.includes(entry.data.category)),
);
const [featuredArticle, ...restArticles] = journalEntries;
const secondaryArticles = restArticles.slice(0, 2);

const ogImage = await getImage({ src: heroFamily, width: 1200, height: 630 });

const tips = [
  {
    title: 'Build in one lazy day',
    body: 'Every trip needs at least one day with nothing booked — it\u2019s usually the one everyone remembers fondly.',
  },
  {
    title: 'Let each kid pick one thing',
    body: 'One activity, restaurant, or stop chosen entirely by them. It costs little and heads off a lot of complaining.',
  },
  {
    title: 'Pack a small "new toy" for travel days',
    body: 'Something they haven\u2019t seen before buys 45 minutes of quiet on a flight or long drive. Wrap it, even.',
  },
  {
    title: 'Check entry requirements early',
    body: 'Passport expiry dates, visa rules, and vaccination requirements are the easiest thing to leave too late.',
  },
];
---

<BaseLayout
  title="Nestward — family trip planning, done properly"
  description="Discover family-friendly destinations, resorts, and travel advice — with honest guides written for parents, not algorithms."
  image={ogImage.src}
>
  <Hero
    image={heroFamily}
    imageAlt="Golden hour illustration of a warm family beach at sunset"
    headline="Create memories that last a lifetime"
    supporting="Discover destinations, resorts, and travel ideas curated for families — so the planning feels as good as the trip."
    primaryCta={{ label: 'Explore destinations', href: '/destinations' }}
    secondaryCta={{ label: 'Find family resorts', href: '/resorts' }}
  />

  <!-- Vacation Discovery -->
  <section class="section">
    <Container size="wide">
      <SectionTitle
        kicker="Start here"
        heading="What kind of trip are you dreaming of?"
        supporting="Six ways families usually start planning — pick one to see destinations and resorts that fit."
      />
      <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
        {tripStyles.map((style, i) => (
          <TravelCategoryCard
            href={`/trip-styles/${style.slug}`}
            image={categoryImages[style.slug]}
            imageAlt={`Illustration representing ${style.label}`}
            label={style.label}
            priority={i < 3}
          />
        ))}
      </div>
    </Container>
  </section>

  <!-- Featured Destinations -->
  <section class="section bg-bg-subtle">
    <Container size="wide">
      <SectionTitle
        kicker="Featured destinations"
        heading="Places families keep going back to"
        supporting="Chosen for the mix of things that actually matter with kids: flight time, food options, and something for every age."
      />
      <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
        {topDestinations.map((entry, i) => (
          <DestinationCard
            href={`/destinations/${entry.data.slugOverride ?? entry.id}`}
            image={entry.data.featuredImage}
            imageAlt={entry.data.featuredImageAlt}
            name={entry.data.title}
            teaser={entry.data.description}
            priority={i === 0}
            class={i === 4 ? 'col-span-2 sm:col-span-1' : ''}
          />
        ))}
      </div>
      <div class="mt-8 text-center">
        <Button href="/destinations" variant="secondary">See all destinations</Button>
      </div>
    </Container>
  </section>

  <!-- Family Resorts -->
  <section class="section">
    <Container size="wide">
      <SectionTitle
        kicker="Family resorts"
        heading="A short, honest shortlist of resorts we'd actually book"
        supporting="No sponsored placements — every resort here earned its spot from reviews and our own editors' research."
      />
      {allResorts.length > 0 && (
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {allResorts.map((entry) => (
            <ResortCard
              href={`/resorts/${entry.data.slugOverride ?? entry.id}`}
              image={entry.data.featuredImage}
              imageAlt={entry.data.featuredImageAlt}
              name={entry.data.title}
              location={entry.data.location}
              bestFor={entry.data.bestForSummary.replace(/^Best for /i, '').split(/ who | that |,/i)[0].replace(/\.$/, '')}
            />
          ))}
        </div>
      )}
      {resortRoundups.length > 0 && (
        <div class="mt-10">
          <p class="text-sm font-semibold text-ink-soft">Or browse resort guides by type:</p>
          <div class="mt-4 flex flex-wrap gap-3">
            {resortRoundups.map((entry) => (
              <a
                href={`/articles/${entry.data.slugOverride ?? entry.id}`}
                class="rounded-full border border-border px-4 py-2 text-sm font-semibold text-ink-soft transition-colors hover:border-green hover:text-green-dark"
              >
                {entry.data.category}
              </a>
            ))}
          </div>
        </div>
      )}
    </Container>
  </section>

  <!-- Travel Inspiration -->
  {featuredArticle && (
    <section class="section bg-bg-subtle">
      <Container size="wide">
        <SectionTitle
          kicker="Travel inspiration"
          heading="Longer reads for the planning rabbit-hole hours"
        />
        <div class="mt-10 flex flex-col gap-12">
          <ArticleCard
            href={`/articles/${featuredArticle.data.slugOverride ?? featuredArticle.id}`}
            image={featuredArticle.data.featuredImage}
            imageAlt={featuredArticle.data.featuredImageAlt}
            category={featuredArticle.data.category}
            title={featuredArticle.data.title}
            excerpt={featuredArticle.data.description}
            meta={featuredArticle.data.readingMinutes ? `${featuredArticle.data.readingMinutes} min read` : undefined}
            featured
            priority
          />
          {secondaryArticles.length > 0 && (
            <div class="grid gap-8 sm:grid-cols-2">
              {secondaryArticles.map((entry) => (
                <ArticleCard
                  href={`/articles/${entry.data.slugOverride ?? entry.id}`}
                  image={entry.data.featuredImage}
                  imageAlt={entry.data.featuredImageAlt}
                  category={entry.data.category}
                  title={entry.data.title}
                  excerpt={entry.data.description}
                  meta={entry.data.readingMinutes ? `${entry.data.readingMinutes} min read` : undefined}
                />
              ))}
            </div>
          )}
        </div>
      </Container>
    </section>
  )}

  <!-- Family Travel Tips -->
  <section class="section">
    <Container size="wide">
      <SectionTitle
        kicker="Quick tips"
        heading="Small things that make a big difference"
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {tips.map((tip) => (
          <Card padding="spacious">
            <h3 class="text-lg font-extrabold text-ink">{tip.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-soft">{tip.body}</p>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <Newsletter />
</BaseLayout>

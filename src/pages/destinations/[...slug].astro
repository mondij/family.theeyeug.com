---
import { getCollection } from 'astro:content';
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import { resolveRelated } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('destinations');
  return entries.map((entry) => ({
    params: { slug: entry.data.slugOverride ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const related = await resolveRelated(entry.data.relatedArticles);
---

<DestinationLayout entry={entry} url={url} related={related} />

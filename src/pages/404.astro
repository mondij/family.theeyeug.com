---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import DestinationCard from '../components/DestinationCard.astro';

const destinations = await getCollection('destinations');
const suggestions = [...destinations]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Page Not Found"
  description="This page doesn't exist — but here's how to find what you were looking for."
  noindex
>
  <Container size="content" class="section text-center">
    <p class="kicker">404</p>
    <h1 class="mt-3 text-4xl font-extrabold text-ink sm:text-5xl">
      We couldn't find that page
    </h1>
    <p class="mx-auto mt-4 max-w-lg text-lg text-ink-soft">
      The link might be out of date, or the page may have moved. Try one of these instead.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/" variant="primary">Back to homepage</Button>
      <Button href="/destinations" variant="secondary">Browse destinations</Button>
    </div>

    {suggestions.length > 0 && (
      <div class="mx-auto mt-16 max-w-4xl text-left">
        <h2 class="text-sm font-semibold text-ink-soft">Or start with one of these:</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-3">
          {suggestions.map((entry, i) => (
            <DestinationCard
              href={`/destinations/${entry.data.slugOverride ?? entry.id}`}
              image={entry.data.featuredImage}
              imageAlt={entry.data.featuredImageAlt}
              name={entry.data.title}
              teaser={entry.data.description}
              priority={i === 0}
            />
          ))}
        </div>
      </div>
    )}
  </Container>
</BaseLayout>

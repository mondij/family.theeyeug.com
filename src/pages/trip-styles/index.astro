---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import TravelCategoryCard from '../../components/TravelCategoryCard.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { tripStyles } from '../../lib/tripStyles';
import type { ImageMetadata } from 'astro';

import catBeach from '../../assets/images/cat-beach.jpg';
import catThemeParks from '../../assets/images/cat-theme-parks.jpg';
import catAllInclusive from '../../assets/images/cat-all-inclusive.jpg';
import catAdventure from '../../assets/images/cat-adventure.jpg';
import catCityBreaks from '../../assets/images/cat-city-breaks.jpg';
import catNationalParks from '../../assets/images/cat-national-parks.jpg';

const images: Record<string, ImageMetadata> = {
  beach: catBeach,
  'theme-parks': catThemeParks,
  'all-inclusive': catAllInclusive,
  adventure: catAdventure,
  'city-breaks': catCityBreaks,
  'national-parks': catNationalParks,
};

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Things to do', href: '/trip-styles' },
];
const breadcrumbsLd = breadcrumbSchema(breadcrumbItems.map((b) => ({ name: b.name, url: b.href })));
---

<BaseLayout
  title="Things To Do — Trip Styles"
  description="Six ways families usually start planning a trip — pick one to see destinations, resorts, and guides that fit."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Breadcrumbs items={breadcrumbItems} />

  <Container size="wide" class="section">
    <SectionTitle level="h1"
      kicker="Things to do"
      heading="What kind of trip are you dreaming of?"
      supporting="Six ways families usually start planning — pick one to see destinations, resorts, and guides that fit."
    />
    <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
      {tripStyles.map((style, i) => (
        <TravelCategoryCard
          href={`/trip-styles/${style.slug}`}
          image={images[style.slug]}
          imageAlt={`Illustration representing ${style.label}`}
          label={style.label}
          priority={i < 3}
        />
      ))}
    </div>
  </Container>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { breadcrumbSchema } from '../../lib/schema';

const entries = await getCollection('articles');

const sorted = [...entries].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

const [featuredEntry, ...restEntries] = sorted;

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Journal', href: '/articles' },
];
const breadcrumbsLd = breadcrumbSchema(breadcrumbItems.map((b) => ({ name: b.name, url: b.href })));
---

<BaseLayout
  title="Family Travel Journal"
  description="Longer reads for the planning rabbit-hole hours — packing lists, honest resort reviews, and season-by-season advice for travelling with kids."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Breadcrumbs items={breadcrumbItems} />

  <Container size="wide" class="section">
    <SectionTitle
      kicker="Journal"
      heading="Longer reads for the planning rabbit-hole hours"
      supporting="Packing lists, honest reviews, and season-by-season advice — written by parents who've done the trip already."
    />

    {featuredEntry ? (
      <div class="mt-10 flex flex-col gap-12">
        <ArticleCard
          href={`/articles/${featuredEntry.data.slugOverride ?? featuredEntry.id}`}
          image={featuredEntry.data.featuredImage}
          imageAlt={featuredEntry.data.featuredImageAlt}
          category={featuredEntry.data.category}
          title={featuredEntry.data.title}
          excerpt={featuredEntry.data.description}
          meta={featuredEntry.data.readingMinutes ? `${featuredEntry.data.readingMinutes} min read` : undefined}
          featured
          priority
        />

        {restEntries.length > 0 && (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {restEntries.map((entry) => (
              <ArticleCard
                href={`/articles/${entry.data.slugOverride ?? entry.id}`}
                image={entry.data.featuredImage}
                imageAlt={entry.data.featuredImageAlt}
                category={entry.data.category}
                title={entry.data.title}
                excerpt={entry.data.description}
                meta={entry.data.readingMinutes ? `${entry.data.readingMinutes} min read` : undefined}
              />
            ))}
          </div>
        )}
      </div>
    ) : (
      <p class="mt-10 text-ink-soft">New guides are on the way — check back soon.</p>
    )}
  </Container>
</BaseLayout>

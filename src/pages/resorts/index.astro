---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ResortCard from '../../components/ResortCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { breadcrumbSchema } from '../../lib/schema';

const entries = await getCollection('resorts');

// Roundup-style "Best X Resorts" pieces live in the articles collection
// (they compare many properties, which fits the guide template better
// than the single-property ResortLayout) — surfaced here so this page
// isn't a dead end while only one dedicated resort review exists.
const resortRoundupCategories = [
  'All-Inclusive Resorts',
  'Caribbean Resorts',
  'Beach Resorts',
  'Luxury Resorts',
  'Kids Clubs',
];
const allArticles = await getCollection('articles');
const roundups = allArticles
  .filter((entry) => resortRoundupCategories.includes(entry.data.category))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const sorted = [...entries].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// bestForSummary is a full sentence ("Best for families with toddlers
// who want a calm week."); the ResortCard badge needs a short phrase,
// so pull out the noun phrase rather than adding a second schema field
// just for this listing page.
function shortBestFor(summary: string) {
  return summary
    .replace(/^Best for /i, '')
    .split(/ who | that |,/i)[0]
    .replace(/\.$/, '');
}

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Family resorts', href: '/resorts' },
];
const breadcrumbsLd = breadcrumbSchema(breadcrumbItems.map((b) => ({ name: b.name, url: b.href })));
---

<BaseLayout
  title="Family Resorts"
  description="A shortlist of resorts we'd actually book — no sponsored placements, every one earned its spot from reviews and our own editors' research."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Breadcrumbs items={breadcrumbItems} />

  <Container size="wide" class="section">
    <SectionTitle level="h1"
      kicker="Family resorts"
      heading="A short, honest shortlist of resorts we'd actually book"
      supporting="No sponsored placements — every resort here earned its spot from reviews and our own editors' research."
    />

    {sorted.length > 0 ? (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((entry, i) => (
          <ResortCard
            href={`/resorts/${entry.data.slugOverride ?? entry.id}`}
            image={entry.data.featuredImage}
            imageAlt={entry.data.featuredImageAlt}
            name={entry.data.title}
            location={entry.data.location}
            bestFor={shortBestFor(entry.data.bestForSummary)}
            priority={i === 0}
            headingLevel={i === 0 ? 'h2' : 'h3'}
          />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-ink-soft">New resort reviews are on the way — check back soon.</p>
    )}

    {roundups.length > 0 && (
      <div class="mt-16 border-t border-border pt-12">
        <SectionTitle
          kicker="Resort guides"
          heading="Looking for a specific type of resort?"
          supporting="Roundups comparing options across all-inclusive, Caribbean, beach, luxury, and kids' club resorts."
        />
        <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {roundups.map((entry) => (
            <ArticleCard
              href={`/articles/${entry.data.slugOverride ?? entry.id}`}
              image={entry.data.featuredImage}
              imageAlt={entry.data.featuredImageAlt}
              category={entry.data.category}
              title={entry.data.title}
              excerpt={entry.data.description}
              meta={entry.data.readingMinutes ? `${entry.data.readingMinutes} min read` : undefined}
            />
          ))}
        </div>
      </div>
    )}
  </Container>
</BaseLayout>

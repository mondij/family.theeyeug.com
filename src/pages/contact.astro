---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Button from '../components/Button.astro';

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact' },
];
---

<BaseLayout
  title="Contact Nestward"
  description="Get in touch with the Nestward team — corrections, partnership questions, or just to say hello."
>
  <Breadcrumbs items={breadcrumbItems} />

  <Container size="narrow" class="section">
    <SectionTitle level="h1" kicker="Contact" heading="Get in touch" />

    <div class="mt-8 flex flex-col gap-6">
      <div class="card p-6 sm:p-7">
        <h2 class="text-lg font-extrabold text-ink">General questions and corrections</h2>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">
          Spotted something out of date, or have a destination you think we should cover?
          We read every message.
        </p>
        <Button href="mailto:hello@nestward.example" variant="secondary" class="mt-4">
          hello@nestward.example
        </Button>
      </div>

      <div class="card p-6 sm:p-7">
        <h2 class="text-lg font-extrabold text-ink">Partnerships and resorts</h2>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">
          If you represent a resort, destination board, or family travel product, see our
          <a href="/partners" class="font-semibold text-green-dark hover:underline">work with us</a> page.
        </p>
      </div>
    </div>
  </Container>
</BaseLayout>
